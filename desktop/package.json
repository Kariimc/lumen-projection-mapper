{
  "name": "lumen-desktop",
  "version": "0.1.0",
  "private": true,
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "test": "node ../test/run-tests.js && node ../test/security-tests.js && node ../test/server-security-tests.js",
    "dist": "electron-builder --win --publish never",
    "postdist": "node ../test/package-tests.js",
    "test:package": "node ../test/package-tests.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "42.11.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.shift9.lumen",
    "productName": "Lumen",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../controller",
        "to": "controller",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    }
  }
}
